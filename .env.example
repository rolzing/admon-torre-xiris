# ============================================================
#  VARIABLES DE ENTORNO — Portal del Condominio
#  ============================================================
#  Copia este archivo a `.env` y completa los valores SOLO si vas
#  a conectar un proyecto Appwrite real.
#
#  Para el DEMO local NO necesitas llenar nada: si estas variables
#  están vacías o faltan, la app corre con datos mock
#  (ver /src/services/mockData.js).
# ============================================================

# ---------- APPWRITE (cloud.appwrite.io / consola) -----------
# Crea un proyecto en Appwrite. Habilita Authentication (email),
# crea una Database (colecciones) y un Storage (bucket).
# Obtén los valores en Project Settings e IDs de cada recurso.
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=
VITE_APPWRITE_DATABASE_ID=
VITE_APPWRITE_COLLECTION_UNIDADES=
VITE_APPWRITE_COLLECTION_AVISOS=
VITE_APPWRITE_COLLECTION_DOCUMENTOS=
VITE_APPWRITE_COLLECTION_GASTOS=
VITE_APPWRITE_COLLECTION_PAGOS=
VITE_APPWRITE_STORAGE_BUCKET_ID=

# ---------- TWILIO (opcional, futuro bot de WhatsApp) ----------
# Estas variables NO se usan en el demo. Alimentarían una función
# futura (ver /src/config/whatsapp.js). Son secretos: viven en el
# entorno de la función, nunca en el bundle del cliente.
VITE_TWILIO_ACCOUNT_SID=
VITE_TWILIO_AUTH_TOKEN=
VITE_TWILIO_WHATSAPP_NUMBER=
