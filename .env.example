# ============================================================
#  VARIABLES DE ENTORNO — Portal del Condominio
#  ============================================================
#  Este archivo documenta TODAS las variables necesarias.
#  Cópialo a `.env` y completa los valores solo si vas a
#  conectar un proyecto Firebase real.
#
#  Para el DEMO local, NO necesitas llenar nada: si estas
#  variables están vacías o faltan, la app corre con datos
#  mock (ver /src/services/mockData.js).
# ============================================================

# ---------- FIREBASE (consola.firebase.google.com) ----------
# Crea un proyecto y habilita: Authentication (email),
# Firestore Database y Storage. Copia los valores de la
# configuración de tu app web.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ---------- TWIOT Twilio (opcional, futuro bot de WhatsApp)
# Estas variables NO se usan en el demo. Alimentarían una
# Cloud Function futura (ver /src/config/whatsapp.js).
VITE_TWILIO_ACCOUNT_SID=
VITE_TWILIO_AUTH_TOKEN=
VITE_TWILIO_WHATSAPP_NUMBER=
VITE_TWILIO_WHATSAPP_FROM=
